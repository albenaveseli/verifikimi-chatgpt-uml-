
@startuml

class Airline {
    - name : String
}

class Airport {
    - code : String
    - city : String
}

class Operation {
    - operatingCost : Decimal
    - startTime : DateTime
    - endTime : DateTime
    + startOperation() : void
    + stopOperation() : void
    + updateOperatingCost(newCost : Decimal) : void
}

Airline "1" -- "0..*" Operation : operates
Airport "1" -- "0..*" Operation : hosts

@enduml
