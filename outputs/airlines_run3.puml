
@startuml

class Airline {
    - name: String
}

class Airport {
    - code: String
    - city: String
}

class AirlineOperation {
    - operatingCost: Decimal
    - startDateTime: DateTime
    - endDateTime: DateTime
    + startOperation(): void
    + stopOperation(): void
    + updateOperatingCost(newCost: Decimal): void
}

Airline "1" -- "0..*" AirlineOperation : has
Airport "1" -- "0..*" AirlineOperation : hosts

@enduml
