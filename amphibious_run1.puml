
@startuml

enum Environment {
    land
    water
    air
}

class Vehicle {
    - position
    - speed : double
    - maximumSpeed : double
    - environment : Environment
    + move(time : double) : void
}

class LandVehicle
class MarineVehicle
class AmphibiousVehicle

Vehicle <|-- LandVehicle
Vehicle <|-- MarineVehicle

LandVehicle <|-- AmphibiousVehicle
MarineVehicle <|-- AmphibiousVehicle

@enduml
